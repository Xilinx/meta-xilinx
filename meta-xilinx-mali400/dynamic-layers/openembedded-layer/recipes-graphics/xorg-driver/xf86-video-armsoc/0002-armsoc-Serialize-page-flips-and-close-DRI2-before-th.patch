From e9cce594198d5cb998a8d5ba8b8931a0983c54c0 Mon Sep 17 00:00:00 2001
From: Parth Gajjar <parth.gajjar@amd.com>
Date: Thu, 3 Sep 2026 07:32:26 -0700
Subject: [PATCH 1/2] armsoc: Serialize page flips and close DRI2 before the
 CloseScreen chain

Two problems turned up running "glmark2-es2 --fullscreen" under a bare Xorg
(no window manager) on zynqmp-dpsub.

1) Page-flip storm

Bare Xorg lets DRI2CanFlip() succeed, so Mali DRI2 page-flips. zynqmp-dpsub
accepts only one outstanding DRM_IOCTL_MODE_PAGE_FLIP, but use_early_display
sets the DRI2 swap-chain size to 2, so DRI2 queues a second flip before the
first flip event arrives and the kernel returns EBUSY:

  flip queue failed: Device or resource busy
  ERROR: swap N ARMSOC_SWAP_FAIL on swap complete
  WARNING: Flip is called too fast

The driver then overwrote the in-flight swap-chain slot and completed the
failed swap as ARMSOC_SWAP_FAIL, freeing DRI2 pixmaps that KMS and EXA still
referenced.

  - Disable early display for zynqmp-dpsub, giving a swap-chain size of 1.
  - Do not overwrite an occupied swap-chain slot; blit this frame instead.
  - On page-flip EBUSY with zero CRTCs queued, blit rather than tearing the
    swap down as ARMSOC_SWAP_FAIL, and only commit the swap to the swap
    chain and bump pending_flips once at least one CRTC has queued.

2) Teardown order

ARMSOCCloseScreen() ran ARMSOCDRI2CloseScreen() after the
pScreen->CloseScreen chain and after destroying the root pixmap, which is
too late: draining an in-flight flip completes its swap, and a swap's
FrontLeft buffer can still hold an X ref on that root pixmap. Close DRI2
first.

Move the scanout-bo transfer in SwapComplete() out of the
dixLookupDrawable() success path as well, so a flip that completes after its
drawable is gone still moves the Screen's scanout ref onto the buffer now on
the CRTC before the unreferences below run - otherwise those unreferences
free a GEM bo that is still being scanned out. set_scanout_bo() only uses
pScrn and the bo, so it is safe with pDraw == NULL.

Finally, avoid two EXA pixmap-private accesses that are not needed and are
not safe during teardown: take the buffer stride from pPixmap->devKind
rather than exaGetPixmapPitch(), and for the FrontLeft screen pixmap drop
the extra X ref directly instead of going through the EXA-wrapped
pScreen->DestroyPixmap(). Null-guard ARMSOCPixmapBo(),
ARMSOCRegisterExternalAccess() and ARMSOCDeregisterExternalAccess() instead
of asserting.

This is a prerequisite for the next patch but not sufficient on its own:
EXA is already unusable by the time CloseScreen() is entered, for the
reason that patch describes.

Upstream-Status: Inappropriate [AMD Mali-400 specific]

AI-Assisted: Claude Opus 5
Signed-off-by: Parth Gajjar <parth.gajjar@amd.com>
---
 src/armsoc_dri2.c                   | 157 +++++++++++++++++++++-------
 src/armsoc_driver.c                 |  23 +++-
 src/armsoc_exa.c                    |  21 +++-
 src/armsoc_exa.h                    |   8 +-
 src/drmmode_xilinx/drmmode_xilinx.c |  11 +-
 5 files changed, 172 insertions(+), 48 deletions(-)

diff --git a/src/armsoc_dri2.c b/src/armsoc_dri2.c
index af5d074..897628c 100644
--- a/src/armsoc_dri2.c
+++ b/src/armsoc_dri2.c
@@ -221,7 +221,14 @@ static Bool create_buffer(DrawablePtr pDraw, struct ARMSOCDRI2BufferRec *buf)
 		goto fail;
 	}
 
-	DRIBUF(buf)->pitch = exaGetPixmapPitch(pPixmap);
+	/*
+	 * Use the pixmap stride directly. exaGetPixmapPitch() reads the EXA
+	 * pixmap private, which asserts (key->initialized) if the pixmap was
+	 * not created through EXA - e.g. the fbScreenInit root pixmap that
+	 * DRI2 wraps as the FrontLeft buffer for a fullscreen unredirected
+	 * window (CR-1279766). devKind carries the same stride.
+	 */
+	DRIBUF(buf)->pitch = pPixmap->devKind;
 	DRIBUF(buf)->cpp = pPixmap->drawable.bitsPerPixel / 8;
 	DRIBUF(buf)->flags = 0;
 	buf->refcnt = 1;
@@ -290,8 +297,30 @@ static Bool destroy_buffer(DrawablePtr pDraw, struct ARMSOCDRI2BufferRec *buf)
 		numBuffers = 1;
 
 	for (i = 0; i < numBuffers && buf->pPixmaps[i] != NULL; i++) {
-		ARMSOCDeregisterExternalAccess(buf->pPixmaps[i]);
-		pScreen->DestroyPixmap(buf->pPixmaps[i]);
+		PixmapPtr pPixmap = buf->pPixmaps[i];
+		PixmapPtr pScreenPix = pScreen->GetScreenPixmap(pScreen);
+
+		ARMSOCDeregisterExternalAccess(pPixmap);
+
+		/*
+		 * create_buffer() wraps the drawable's existing pixmap for the
+		 * FrontLeft buffer and only takes an extra X ref on it
+		 * (pPixmap->refcnt++). For a fullscreen unredirected window
+		 * that pixmap is the fbScreenInit root/screen pixmap, which EXA
+		 * is not aware of. Routing it through the EXA-wrapped
+		 * pScreen->DestroyPixmap() calls dixGetPrivateAddr() on the EXA
+		 * pixmap key and aborts bare Xorg on teardown (CR-1279766:
+		 * dixGetPrivateAddr: Assertion `key->initialized' failed).
+		 * Drop the extra ref we took in create_buffer() directly.
+		 */
+		if (buffer->attachment == DRI2BufferFrontLeft &&
+		    pPixmap == pScreenPix) {
+			if (pPixmap->refcnt > 1)
+				pPixmap->refcnt--;
+			continue;
+		}
+
+		pScreen->DestroyPixmap(pPixmap);
 	}
 
 	return TRUE;
@@ -693,19 +722,31 @@ ARMSOCDRI2SwapComplete(struct ARMSOCDRISwapCmd *cmd)
 		status = dixLookupDrawable(&pDraw, cmd->draw_id, serverClient,
 				M_ANY, DixWriteAccess);
 
-		if (status == Success) {
-
+		if (status == Success)
 			DRI2SwapComplete(cmd->client, pDraw, 0, 0, 0, cmd->type,
 					cmd->func, cmd->data);
-
-			if (cmd->type != DRI2_BLIT_COMPLETE &&
-			    cmd->type != DRI2_EXCHANGE_COMPLETE &&
-			   (cmd->flags & ARMSOC_SWAP_FAKE_FLIP) == 0) {
-				assert(cmd->type == DRI2_FLIP_COMPLETE);
-				set_scanout_bo(pScrn, cmd->new_scanout);
-			}
-		} else {
+		else
 			ERROR_MSG("dixLookupDrawable fail on swap complete");
+
+		/*
+		 * Move the Screen's scanout ref onto the buffer now on the CRTC
+		 * even when the client/drawable is already gone. glmark2 exit /
+		 * Ctrl+C destroys the drawable before the in-flight page-flip
+		 * event arrives, so dixLookupDrawable() above fails - but the
+		 * flip still happened and this buffer is what the CRTC (and the
+		 * root pixmap) now reference. If we skip this, the unreferences
+		 * below free a GEM BO that is still being scanned out and
+		 * teardown then dies in EXA (CR-1279766: intermittent
+		 * "dixLookupDrawable fail on swap complete" followed by
+		 * !key->initialized). set_scanout_bo() only touches pScrn and
+		 * the bo, so it is safe with pDraw == NULL, and cmd->new_scanout
+		 * is still held alive by the swap chain's old_src_bo ref here.
+		 */
+		if (cmd->type != DRI2_BLIT_COMPLETE &&
+		    cmd->type != DRI2_EXCHANGE_COMPLETE &&
+		   (cmd->flags & ARMSOC_SWAP_FAKE_FLIP) == 0) {
+			assert(cmd->type == DRI2_FLIP_COMPLETE);
+			set_scanout_bo(pScrn, cmd->new_scanout);
 		}
 	} else {
 		ERROR_MSG("swap %d ARMSOC_SWAP_FAIL on swap complete", cmd->swap_id);
@@ -852,6 +893,24 @@ ARMSOCDRI2ScheduleSwap(ClientPtr client, DrawablePtr pDraw,
 	do_flip = do_flip &&
 			(armsoc_bo_height(src_bo) == armsoc_bo_height(dst_bo));
 
+	/*
+	 * zynqmp-dpsub (and similar single-flip controllers) accept only one
+	 * outstanding DRM_IOCTL_MODE_PAGE_FLIP. use_early_display, or a client
+	 * that runs ahead, can still request another swap before the previous
+	 * flip event arrives. Overwriting the in-flight swap-chain slot and
+	 * completing the failed flip as ARMSOC_SWAP_FAIL frees DRI2 pixmaps
+	 * KMS/EXA still reference, which crashes bare Xorg (no WM) on client
+	 * exit / Ctrl+C (CR-1279766). If a flip is already pending, present
+	 * this frame with a blit instead of queuing a second flip.
+	 */
+	if (do_flip &&
+	    (NULL != pARMSOC->swap_chain[pARMSOC->swap_chain_count %
+					 pARMSOC->swap_chain_size] ||
+	     pARMSOC->pending_flips >= (int)pARMSOC->swap_chain_size)) {
+		WARNING_MSG("Flip requested while one is still pending, falling back to blit\n");
+		do_flip = FALSE;
+	}
+
 	if (do_flip) {
 		if (pARMSOC->shadow)
 			src_fb_id = armsoc_bo_get_fb(pARMSOC->shadow);
@@ -859,40 +918,58 @@ ARMSOCDRI2ScheduleSwap(ClientPtr client, DrawablePtr pDraw,
 		DEBUG_MSG("FLIPPING:  FB%d -> FB%d", src_fb_id, dst_fb_id);
 		cmd->type = DRI2_FLIP_COMPLETE;
 
-		/* Add swap operation to the swap chain */
-		cmd->swap_id = pARMSOC->swap_chain_count++;
+		/* Reserve (but do not yet commit) this swap-chain slot */
+		cmd->swap_id = pARMSOC->swap_chain_count;
 		idx = cmd->swap_id % pARMSOC->swap_chain_size;
-		if (NULL != pARMSOC->swap_chain[idx])
-			WARNING_MSG("Flip is called too fast\n");
-		pARMSOC->swap_chain[idx] = cmd;
 		/* TODO: MIDEGL-1461: Handle rollback if multiple CRTC flip is
 		 * only partially successful
 		 */
-		pARMSOC->pending_flips++;
 		ret = drmmode_page_flip(pDraw, src_fb_id, cmd);
 
-		/* If using page flip events, we'll trigger an immediate
-		 * completion in the case that no CRTCs were enabled to be
-		 * flipped. If not using page flip events, trigger immediate
-		 * completion unconditionally.
+		/* drmmode_page_flip() returns the number of CRTCs that queued a
+		 * flip (0 => no enabled CRTC, i.e. a "fake" flip), or
+		 * -(queued + 1) if at least one CRTC failed to queue its flip.
 		 */
-		if (ret < 0) {
+		if (ret < 0 && -(ret + 1) == 0) {
 			/*
-			 * Error while flipping; bail.
+			 * No CRTC queued a flip - typically EBUSY because a
+			 * flip is already outstanding on this controller. Do
+			 * not tear the swap down as ARMSOC_SWAP_FAIL (that
+			 * frees pixmaps still in use); present this frame with
+			 * a blit instead. Nothing was queued, so no page-flip
+			 * event is owed and the swap chain is left untouched.
 			 */
-			cmd->flags |= ARMSOC_SWAP_FAIL;
-
-			if (pARMSOC->drmmode_interface->use_page_flip_events)
-				cmd->swapCount = -(ret + 1);
-			else
-				cmd->swapCount = 0;
-
-			cmd->new_scanout = boFromBuffer(pDstBuffer);
-			if (cmd->swapCount == 0)
-				ARMSOCDRI2SwapComplete(cmd);
-
-			return FALSE;
+			WARNING_MSG("Page flip failed (%d), falling back to blit\n",
+					ret);
+			do_flip = FALSE;
+			cmd->type = 0;
 		} else {
+			/* At least one CRTC has (or will) flip: commit the
+			 * swap to the swap chain now.
+			 */
+			pARMSOC->swap_chain[idx] = cmd;
+			pARMSOC->swap_chain_count++;
+			pARMSOC->pending_flips++;
+
+			if (ret < 0) {
+				/*
+				 * Partial success: some CRTCs are in flight;
+				 * wait for their page-flip events.
+				 */
+				cmd->flags |= ARMSOC_SWAP_FAIL;
+
+				if (pARMSOC->drmmode_interface->use_page_flip_events)
+					cmd->swapCount = -(ret + 1);
+				else
+					cmd->swapCount = 0;
+
+				cmd->new_scanout = boFromBuffer(pDstBuffer);
+				if (cmd->swapCount == 0)
+					ARMSOCDRI2SwapComplete(cmd);
+
+				return FALSE;
+			}
+
 			if (ret == 0)
 				cmd->flags |= ARMSOC_SWAP_FAKE_FLIP;
 
@@ -920,8 +997,12 @@ ARMSOCDRI2ScheduleSwap(ClientPtr client, DrawablePtr pDraw,
 			cmd->new_scanout = boFromBuffer(pDstBuffer);
 			if (cmd->swapCount == 0)
 				ARMSOCDRI2SwapComplete(cmd);
+
+			return TRUE;
 		}
-	} else if (canexchange(pDraw, src_bo, dst_bo)) {
+	}
+
+	if (canexchange(pDraw, src_bo, dst_bo)) {
 		exchangebufs(pDraw, pSrcBuffer, pDstBuffer);
 		if (pSrcBuffer->attachment == DRI2BufferBackLeft)
 			nextBuffer(pDraw, ARMSOCBUF(pSrcBuffer));
diff --git a/src/armsoc_driver.c b/src/armsoc_driver.c
index 15cc620..f12f927 100644
--- a/src/armsoc_driver.c
+++ b/src/armsoc_driver.c
@@ -1406,6 +1406,26 @@ ARMSOCCloseScreen(CLOSE_SCREEN_ARGS_DECL)
 	drmmode_screen_fini(pScrn);
 	drmmode_cursor_fini(pScreen);
 
+	/*
+	 * Tear DRI2 down before the CloseScreen chain runs.
+	 *
+	 * The chain calls exaCloseScreen(), which free()s the EXA screen
+	 * private - and the EXA *pixmap* private key lives inside that struct
+	 * (ExaScreenPrivRec.pixmapPrivateKeyRec, see ExaGetPixmapPriv()).
+	 * ARMSOCDRI2CloseScreen() drains any in-flight page flip, and
+	 * completing that swap destroys its DRI2 buffers, which touches the
+	 * EXA pixmap private. Doing that after exaCloseScreen() reads a freed
+	 * key and kills bare Xorg (no WM) on client exit / Ctrl+C
+	 * (CR-1279766: dixGetPrivateAddr: Assertion `key->initialized'
+	 * failed). It is intermittent because it needs a flip in flight when
+	 * the client goes away.
+	 *
+	 * DRI2 buffers can also still hold a ref on the root pixmap, so this
+	 * has to happen before that pixmap is destroyed below too.
+	 */
+	if (pARMSOC->dri)
+		ARMSOCDRI2CloseScreen(pScreen);
+
 	/* pScreen->devPrivate holds the root pixmap created around our bo by miCreateResources which is installed
 	 * by fbScreenInit() when called from ARMSOCScreenInit().
 	 * This pixmap should be destroyed in miScreenClose() but this isn't wrapped by fbScreenInit() so to prevent a leak
@@ -1423,9 +1443,6 @@ ARMSOCCloseScreen(CLOSE_SCREEN_ARGS_DECL)
 
 	ret = (*pScreen->CloseScreen)(CLOSE_SCREEN_ARGS);
 
-	if (pARMSOC->dri)
-		ARMSOCDRI2CloseScreen(pScreen);
-
 	if (pARMSOC->pARMSOCEXA)
 		if (pARMSOC->pARMSOCEXA->CloseScreen)
 			pARMSOC->pARMSOCEXA->CloseScreen(CLOSE_SCREEN_ARGS);
diff --git a/src/armsoc_exa.c b/src/armsoc_exa.c
index 7edf0ac..4c82f7f 100644
--- a/src/armsoc_exa.c
+++ b/src/armsoc_exa.c
@@ -467,23 +467,36 @@ ARMSOCPixmapIsOffscreen(PixmapPtr pPixmap)
 
 void ARMSOCRegisterExternalAccess(PixmapPtr pPixmap)
 {
-	struct ARMSOCPixmapPrivRec *priv = exaGetPixmapDriverPrivate(pPixmap);
+	struct ARMSOCPixmapPrivRec *priv;
+
+	if (!pPixmap)
+		return;
+
+	priv = exaGetPixmapDriverPrivate(pPixmap);
+	if (!priv)
+		return;
 
 	priv->ext_access_cnt++;
 }
 
 void ARMSOCDeregisterExternalAccess(PixmapPtr pPixmap)
 {
-	struct ARMSOCPixmapPrivRec *priv = exaGetPixmapDriverPrivate(pPixmap);
+	struct ARMSOCPixmapPrivRec *priv;
+
+	if (!pPixmap)
+		return;
+
+	priv = exaGetPixmapDriverPrivate(pPixmap);
+	if (!priv || priv->ext_access_cnt <= 0)
+		return;
 
-	assert(priv->ext_access_cnt > 0);
 	priv->ext_access_cnt--;
 
 	if (priv->ext_access_cnt == 0) {
 		/* No DRI2 buffers wrapping the pixmap, so no
 		 * need for synchronisation with dma_buf
 		 */
-		if (armsoc_bo_has_dmabuf(priv->bo))
+		if (priv->bo && armsoc_bo_has_dmabuf(priv->bo))
 			armsoc_bo_clear_dmabuf(priv->bo);
 	}
 }
diff --git a/src/armsoc_exa.h b/src/armsoc_exa.h
index 002b351..5bde1e3 100644
--- a/src/armsoc_exa.h
+++ b/src/armsoc_exa.h
@@ -125,8 +125,12 @@ Bool ARMSOCPixmapIsOffscreen(PixmapPtr pPixmap);
 static inline struct armsoc_bo *
 ARMSOCPixmapBo(PixmapPtr pPixmap)
 {
-	struct ARMSOCPixmapPrivRec *priv = exaGetPixmapDriverPrivate(pPixmap);
-	return priv->bo;
+	struct ARMSOCPixmapPrivRec *priv;
+
+	if (!pPixmap)
+		return NULL;
+	priv = exaGetPixmapDriverPrivate(pPixmap);
+	return priv ? priv->bo : NULL;
 }
 
 void ARMSOCPixmapExchange(PixmapPtr a, PixmapPtr b);
diff --git a/src/drmmode_xilinx/drmmode_xilinx.c b/src/drmmode_xilinx/drmmode_xilinx.c
index c6ed0be..5dae721 100644
--- a/src/drmmode_xilinx/drmmode_xilinx.c
+++ b/src/drmmode_xilinx/drmmode_xilinx.c
@@ -64,7 +64,16 @@ static int create_custom_gem(int fd, struct armsoc_create_gem *create_gem)
 struct drmmode_interface xilinx_interface = {
 	"zynqmp-dpsub"        /* name of drm driver */,
 	1                     /* use_page_flip_events */,
-	1                     /* use_early_display */,
+	/*
+	 * zynqmp-dpsub accepts only one outstanding DRM_IOCTL_MODE_PAGE_FLIP.
+	 * Early display sets the DRI2 swap-chain size to 2, so Mali DRI2
+	 * queues a second flip while the first is still pending and the
+	 * kernel returns EBUSY. The driver then tears the failed swap down as
+	 * ARMSOC_SWAP_FAIL and frees DRI2 pixmaps KMS/EXA still reference,
+	 * which crashes bare Xorg (no WM) on client exit / Ctrl+C
+	 * (CR-1279766). Keep the swap-chain at size 1 for this controller.
+	 */
+	0                     /* use_early_display */,
 	0                     /* cursor width */,
 	0                     /* cursor_height */,
 	0                     /* cursor padding */,
-- 
2.54.0

