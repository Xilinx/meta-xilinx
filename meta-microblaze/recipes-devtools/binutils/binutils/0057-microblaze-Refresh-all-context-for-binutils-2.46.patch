 		  /* Look at the reloc only if the value has been resolved.  */
@@ -2128,6 +2210,9 @@ microblaze_elf_relax_section (bfd *abfd,
 		      target_address = immediate;
 		      offset = calc_fixup (target_address, 0, sec);
 		      immediate -= offset;
