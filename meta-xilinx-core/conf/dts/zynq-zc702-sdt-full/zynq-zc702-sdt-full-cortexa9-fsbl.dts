                ps7_afi_0: ps7-afi@f8008000 {
                        phandle = <0x8>;
                        compatible = "xlnx,ps7-afi-1.00.a";
                        status = "okay";
                        xlnx,ip-name = "ps7_afi";
                        reg = <0xf8008000 0x1000>;
