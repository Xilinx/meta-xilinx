From 88b15dc1435134765626104ebee93f7ca59269b5 Mon Sep 17 00:00:00 2001
From: Akhil Raghu Menon <akhil.raghu.menon@amd.com>
Date: Thu, 24 Sep 2026 14:16:46 -0700
Subject: [PATCH 8/8] libdrm/modetest: Add P0AL/P2AL/P0CL/P2CL/P212 YUV formats

Add fourcc definitions and modetest pattern generation support for five
semi-planar YCbCr formats used by AMD Xilinx display hardware:

  P0AL: 2-plane 4:2:0, 10-bit LSB aligned (10-bit values in bits [9:0])
  P2AL: 2-plane 4:2:2, 10-bit LSB aligned (10-bit values in bits [9:0])
  P0CL: 2-plane 4:2:0, 12-bit LSB aligned (12-bit values in bits [11:0])
  P2CL: 2-plane 4:2:2, 12-bit LSB aligned (12-bit values in bits [11:0])
  P212: 2-plane 4:2:2, 12-bit MSB aligned (12-bit values in bits [15:4])

The four LSB aligned formats mirror the memory layout of P010, P210,
P012 and P212 respectively and differ only in bit placement, so they
reuse fill_smpte_yuv_planar_xx_bpc_16() and
fill_tiles_yuv_planar_xx_bpc_16() with msb=false and a bpc of 10 or 12.
P212 is laid out identically to P012 and joins its existing case group.

All five formats are added to each of the three switch statements in
bo_create(): the bpp selection, the is_planar/xsub/ysub selection and
the per-plane offset calculation. Omitting the second of these leaves
is_planar false, so no chroma space is allocated and the SMPTE fill
writes past the end of the mapping.

Upstream-Status: Inappropriate [Xilinx specific]
Signed-off-by: Akhil Raghu Menon <akhil.raghu.menon@amd.com>
---
 include/drm/drm_fourcc.h | 43 ++++++++++++++++++++++++++++++++++++++++
 tests/modetest/buffers.c | 15 ++++++++++++++
 tests/util/format.c      |  5 +++++
 tests/util/pattern.c     | 30 ++++++++++++++++++++++++++++
 4 files changed, 93 insertions(+)

diff --git a/include/drm/drm_fourcc.h b/include/drm/drm_fourcc.h
index 6d31626..3425c23 100644
--- a/include/drm/drm_fourcc.h
+++ b/include/drm/drm_fourcc.h
@@ -359,6 +359,31 @@ extern "C" {
  */
 #define DRM_FORMAT_P210		fourcc_code('P', '2', '1', '0') /* 2x1 subsampled Cr:Cb plane, 10 bit per channel */
 
+/*
+ * 2 plane YCbCr MSB aligned, 12 bits per channel
+ * index 0 = Y plane, [15:0] Y:x [12:4] little endian
+ * index 1 = Cr:Cb plane, [31:0] Cr:x:Cb:x [12:4:12:4] little endian
+ */
+#define DRM_FORMAT_P212		fourcc_code('P', '2', '1', '2') /* 2x1 subsampled Cr:Cb plane, 12 bits per channel */
+
+/*
+ * 2 plane YCbCr 4:2:2 LSB aligned
+ * index 0 = Y plane,     [15:0] x:Y [9:0] little endian
+ * index 1 = Cr:Cb plane, [31:0] x:Cr:x:Cb [9:0:9:0] little endian
+ *
+ * Similar to P210, but 10-bit samples are aligned to the least-significant bits.
+ */
+#define DRM_FORMAT_P2AL		fourcc_code('P', '2', 'A', 'L') /* 2x1 subsampled Cr:Cb plane, 10 bits/ch, LSB aligned */
+
+/*
+ * 2 plane YCbCr 4:2:2 LSB aligned, 12 bits per channel
+ * index 0 = Y plane,     [15:0] x:Y [11:0] little endian
+ * index 1 = Cr:Cb plane, [31:0] x:Cr:x:Cb [11:0:11:0] little endian
+ *
+ * Similar to P210/P212, but 12-bit samples are aligned to the least-significant bits.
+ */
+#define DRM_FORMAT_P2CL		fourcc_code('P', '2', 'C', 'L') /* 2x1 subsampled Cr:Cb plane, 12 bits/ch, LSB aligned */
+
 /*
  * 2 plane YCbCr MSB aligned
  * index 0 = Y plane, [15:0] Y:x [10:6] little endian
@@ -366,6 +391,24 @@ extern "C" {
  */
 #define DRM_FORMAT_P010		fourcc_code('P', '0', '1', '0') /* 2x2 subsampled Cr:Cb plane 10 bits per channel */
 
+/*
+ * 2 plane YCbCr 4:2:0 LSB aligned
+ * index 0 = Y plane,     [15:0] x:Y [9:0] little endian
+ * index 1 = Cr:Cb plane, [31:0] x:Cr:x:Cb [9:0:9:0] little endian
+ *
+ * Similar to P010, but 10-bit samples are aligned to the least-significant bits.
+ */
+#define DRM_FORMAT_P0AL		fourcc_code('P', '0', 'A', 'L') /* 2x2 subsampled Cr:Cb plane 10 bits/ch, LSB aligned */
+
+/*
+ * 2 plane YCbCr 4:2:0 LSB aligned, 12 bits per channel
+ * index 0 = Y plane,     [15:0] x:Y [11:0] little endian
+ * index 1 = Cr:Cb plane, [31:0] x:Cr:x:Cb [11:0:11:0] little endian
+ *
+ * Similar to P012, but 12-bit samples are aligned to the least-significant bits.
+ */
+#define DRM_FORMAT_P0CL		fourcc_code('P', '0', 'C', 'L') /* 2x2 subsampled Cr:Cb plane 12 bits/ch, LSB aligned */
+
 /*
  * 2 plane YCbCr MSB aligned
  * index 0 = Y plane, [15:0] Y:x [12:4] little endian
diff --git a/tests/modetest/buffers.c b/tests/modetest/buffers.c
index 53baf79..f11b5a9 100644
--- a/tests/modetest/buffers.c
+++ b/tests/modetest/buffers.c
@@ -197,7 +197,12 @@ bo_create(int fd, unsigned int format,
 	case DRM_FORMAT_S410:
 	case DRM_FORMAT_S412:
 	case DRM_FORMAT_P210:
+	case DRM_FORMAT_P212:
+	case DRM_FORMAT_P2AL:
+	case DRM_FORMAT_P2CL:
 	case DRM_FORMAT_P010:
+	case DRM_FORMAT_P0AL:
+	case DRM_FORMAT_P0CL:
 	case DRM_FORMAT_P012:
 #ifdef DRM_FORMAT_Y10
 	case DRM_FORMAT_Y10:
@@ -335,7 +340,12 @@ bo_create(int fd, unsigned int format,
 	case DRM_FORMAT_YUV422:
 	case DRM_FORMAT_YVU422:
 	case DRM_FORMAT_P210:
+	case DRM_FORMAT_P212:
+	case DRM_FORMAT_P2AL:
+	case DRM_FORMAT_P2CL:
 	case DRM_FORMAT_P010:
+	case DRM_FORMAT_P0AL:
+	case DRM_FORMAT_P0CL:
 	case DRM_FORMAT_P012:
 		is_planar = true;
 		xsub = 2;
@@ -440,7 +450,12 @@ bo_create(int fd, unsigned int format,
 	case DRM_FORMAT_NV20:
 	case DRM_FORMAT_NV30:
 	case DRM_FORMAT_P210:
+	case DRM_FORMAT_P212:
+	case DRM_FORMAT_P2AL:
+	case DRM_FORMAT_P2CL:
 	case DRM_FORMAT_P010:
+	case DRM_FORMAT_P0AL:
+	case DRM_FORMAT_P0CL:
 	case DRM_FORMAT_P012:
 	case DRM_FORMAT_T508:
 	case DRM_FORMAT_T50A:
diff --git a/tests/util/format.c b/tests/util/format.c
index 324f118..4e86fd3 100644
--- a/tests/util/format.c
+++ b/tests/util/format.c
@@ -62,7 +62,12 @@ static const struct util_format_info format_info[] = {
 	{ DRM_FORMAT_XV15, "XV15", MAKE_YUV_INFO(YUV_YCbCr, 2, 2, 2) },
 	{ DRM_FORMAT_XV20, "XV20", MAKE_YUV_INFO(YUV_YCbCr, 2, 1, 2) },
 	{ DRM_FORMAT_P210, "P210", MAKE_YUV_INFO(YUV_YCbCr, 2, 1, 2) },
+	{ DRM_FORMAT_P212, "P212", MAKE_YUV_INFO(YUV_YCbCr, 2, 1, 2) },
+	{ DRM_FORMAT_P2AL, "P2AL", MAKE_YUV_INFO(YUV_YCbCr, 2, 1, 2) },
+	{ DRM_FORMAT_P2CL, "P2CL", MAKE_YUV_INFO(YUV_YCbCr, 2, 1, 2) },
 	{ DRM_FORMAT_P010, "P010", MAKE_YUV_INFO(YUV_YCbCr, 2, 2, 2) },
+	{ DRM_FORMAT_P0AL, "P0AL", MAKE_YUV_INFO(YUV_YCbCr, 2, 2, 2) },
+	{ DRM_FORMAT_P0CL, "P0CL", MAKE_YUV_INFO(YUV_YCbCr, 2, 2, 2) },
 	{ DRM_FORMAT_P012, "P012", MAKE_YUV_INFO(YUV_YCbCr, 2, 2, 2) },
 	{ DRM_FORMAT_T508, "T508", MAKE_YUV_INFO(YUV_YCbCr, 2, 2, 2) },
 	{ DRM_FORMAT_T608, "T608", MAKE_YUV_INFO(YUV_YCbCr, 2, 2, 2) },
diff --git a/tests/util/pattern.c b/tests/util/pattern.c
index dc1986e..434a65d 100644
--- a/tests/util/pattern.c
+++ b/tests/util/pattern.c
@@ -2610,6 +2610,21 @@ static void fill_smpte(const struct util_format_info *info,
 						       width, height, stride,
 						       10 /* bpc */, true /* msb */);
 
+	case DRM_FORMAT_P2AL:
+	case DRM_FORMAT_P0AL:
+		return fill_smpte_yuv_planar_xx_bpc_16(&info->yuv, planes[0],
+						       planes[1], planes[1] + 2,
+						       width, height, stride,
+						       10 /* bpc */, false /* lsb */);
+
+	case DRM_FORMAT_P2CL:
+	case DRM_FORMAT_P0CL:
+		return fill_smpte_yuv_planar_xx_bpc_16(&info->yuv, planes[0],
+						       planes[1], planes[1] + 2,
+						       width, height, stride,
+						       12 /* bpc */, false /* lsb */);
+
+	case DRM_FORMAT_P212:
 	case DRM_FORMAT_P012:
 		return fill_smpte_yuv_planar_xx_bpc_16(&info->yuv, planes[0],
 						       planes[1], planes[1] + 2,
@@ -3644,6 +3659,21 @@ static void fill_tiles(const struct util_format_info *info,
 						       width, height, stride,
 						       10 /* bpc */, true /* msb */);
 
+	case DRM_FORMAT_P2AL:
+	case DRM_FORMAT_P0AL:
+		return fill_tiles_yuv_planar_xx_bpc_16(info, planes[0],
+						       planes[1], planes[1] + 2,
+						       width, height, stride,
+						       10 /* bpc */, false /* lsb */);
+
+	case DRM_FORMAT_P2CL:
+	case DRM_FORMAT_P0CL:
+		return fill_tiles_yuv_planar_xx_bpc_16(info, planes[0],
+						       planes[1], planes[1] + 2,
+						       width, height, stride,
+						       12 /* bpc */, false /* lsb */);
+
+	case DRM_FORMAT_P212:
 	case DRM_FORMAT_P012:
 		return fill_tiles_yuv_planar_xx_bpc_16(info, planes[0],
 						       planes[1], planes[1] + 2,
