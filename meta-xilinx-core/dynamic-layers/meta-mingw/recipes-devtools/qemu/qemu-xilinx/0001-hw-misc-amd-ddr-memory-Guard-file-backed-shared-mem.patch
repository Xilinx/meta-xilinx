From 5f1a3c6a1c3f2e5f8b7d3a2e9c0d4b5e6a7f8c9d Mon Sep 17 00:00:00 2001
From: Sandeep Gundlupet Raju <sandeep.gundlupet-raju@amd.com>
Date: Wed, 22 Jul 2026 12:20:00 -0600
Subject: [qemu-xilinx][PATCH] hw/misc/amd-ddr-memory: Guard file-backed
 shared memory with CONFIG_POSIX

memory_region_init_ram_from_file() is only declared/implemented under
"#ifdef CONFIG_POSIX" in include/system/memory.h and system/memory.c,
since it relies on mmap()-ing a backing file. amd-ddr-memory.c calls it
unconditionally when shared memory is requested (or auto-detected via
"machine_path"), which fails to build for non-POSIX hosts such as the
mingw32/Windows nativesdk target:

  hw/misc/amd-ddr-memory.c: In function 'amd_ddr_memory_realize':
  hw/misc/amd-ddr-memory.c:41:9: error: implicit declaration of
  function 'memory_region_init_ram_from_file'; did you mean
  'memory_region_init_ram_nomigrate'? [-Wimplicit-function-declaration]

Guard the file-backed shared memory path with "#ifdef CONFIG_POSIX",
matching how memory_region_init_ram_from_file() itself is declared.
On non-POSIX hosts, ON_OFF_AUTO_AUTO now always resolves to
ON_OFF_AUTO_OFF (plain, non-shared RAM), and explicitly requesting
shared=on reports a clear error instead of failing to build.

Upstream-Status: Inappropriate [Xilinx QEMU specific]

AI-Generated: GitHub Copilot (Claude Sonnet 5)

Signed-off-by: Sandeep Gundlupet Raju <sandeep.gundlupet-raju@amd.com>
---
 hw/misc/amd-ddr-memory.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/hw/misc/amd-ddr-memory.c b/hw/misc/amd-ddr-memory.c
index 1111111..2222222 100644
--- a/hw/misc/amd-ddr-memory.c
+++ b/hw/misc/amd-ddr-memory.c
@@ -15,7 +15,9 @@
 {
     AMDDDRMemory *s = AMD_DDR_MEMORY(dev);
     g_autofree char *name = NULL;
+#ifdef CONFIG_POSIX
     g_autoptr(GString) filename = NULL;
+#endif
 
     if (s->size == 0) {
         error_setg(errp, "ddr-memory: size must be non-zero");
@@ -23,7 +25,11 @@
     }
 
     if (s->shared == ON_OFF_AUTO_AUTO) {
+#ifdef CONFIG_POSIX
         s->shared = machine_path ? ON_OFF_AUTO_ON : ON_OFF_AUTO_OFF;
+#else
+        s->shared = ON_OFF_AUTO_OFF;
+#endif
     }
 
     name = g_strdup_printf("ddr@0x%" PRIx64, (uint64_t)s->address);
@@ -34,12 +40,17 @@
         break;
 
     case ON_OFF_AUTO_ON:
+#ifdef CONFIG_POSIX
         filename = g_string_new("");
 
         g_string_append_printf(filename, "%s%cqemu-memory-%s",
                                machine_path ?: ".", G_DIR_SEPARATOR, name);
         memory_region_init_ram_from_file(&s->mr, OBJECT(dev), name, s->size, 0,
                                          RAM_SHARED, filename->str, 0, errp);
+#else
+        error_setg(errp,
+                   "ddr-memory: shared memory backend is not supported on this host");
+#endif
         break;
 
     default:
