+
diff --git a/board-versal-pmc-virt-alt.dts b/board-versal-pmc-virt-alt.dts
new file mode 100644
index 000000000..bda73a858
--- /dev/null
+++ b/board-versal-pmc-virt-alt.dts
@@ -0,0 +1,6 @@
+#include "board-versal-pmc-virt.dts"
+
+#ifndef MULTI_ARCH
+#include "alternative-uart-order.dtsi"
+#endif
+
diff --git a/board-versal-pmx-virt-alt.dts b/board-versal-pmx-virt-alt.dts
