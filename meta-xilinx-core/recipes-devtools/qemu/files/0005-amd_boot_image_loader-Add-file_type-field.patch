diff --git a/amd_boot_image_loader/versal_2vp.py b/amd_boot_image_loader/versal_2vp.py
index 2b097a5..fe5b773 100644
--- a/amd_boot_image_loader/versal_2vp.py
+++ b/amd_boot_image_loader/versal_2vp.py
@@ -19,6 +19,8 @@ so only that window is re-read after the inherited parse.
 import struct
 from pathlib import Path
 
+from .loader import FileType
+
 from .versal import (
     VersalBootImageLoader,
     VersalBootHeader,
@@ -108,6 +110,9 @@ class Versal2VPBootImageLoader(VersalBootImageLoader):
     Versal2VPPBootImageLoader otherwise.
     """
 
+    # Settled by open(), which rebinds the instance to the detected format.
+    file_type = FileType.UNKNOWN
+
     def open(self, image_path=None, image_path_offset=None):
         path = image_path or self.image_path
         if path is None:
@@ -151,6 +156,8 @@ class Versal2VPPBootHeader(Versal2VE2VMBootHeader):
 
 
 class Versal2VPPBootImageLoader(Versal2VE2VMBootImageLoader):
+    file_type = FileType.VERSAL2VPP
+
     def __init__(self, image_path=None, image_path_offset=0):
         super().__init__(image_path, image_path_offset)
         self.boot_header = Versal2VPPBootHeader()
