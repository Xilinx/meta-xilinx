diff --git a/test_versal_2ve_2vm_loader.py b/test_versal_2ve_2vm_loader.py
index 11b2c35..946d427 100755
--- a/test_versal_2ve_2vm_loader.py
+++ b/test_versal_2ve_2vm_loader.py
@@ -8,6 +8,7 @@
 import sys
 import argparse
 from pathlib import Path
+from amd_boot_image_loader.loader import FileType
 from amd_boot_image_loader.versal_2ve_2vm import Versal2VE2VMBootImageLoader
 
 
@@ -70,6 +71,11 @@ Examples:
     try:
         # Create loader instance and use context manager
         with Versal2VE2VMBootImageLoader(file_path, offset) as loader:
+            if loader.file_type != FileType.VERSAL2VE2VM:
+                print(f"Error: unexpected boot image type: {loader.file_type.name}",
+                      file=sys.stderr)
+                return 1
+
             # Parse the image
             loader.parse()
             
diff --git a/test_versal_2vp_loader.py b/test_versal_2vp_loader.py
index 4849265..1128a76 100755
--- a/test_versal_2vp_loader.py
+++ b/test_versal_2vp_loader.py
@@ -8,6 +8,7 @@
 import sys
 import argparse
 from pathlib import Path
+from amd_boot_image_loader.loader import FileType
 from amd_boot_image_loader.versal_2vp import Versal2VPBootImageLoader
 
 
@@ -70,6 +71,12 @@ Examples:
     try:
         # Create loader instance and use context manager
         with Versal2VPBootImageLoader(file_path, offset) as loader:
+            if loader.file_type not in (FileType.VERSAL, FileType.VERSAL2VPP):
+                print(f"Error: unexpected boot image type: {loader.file_type.name}",
+                      file=sys.stderr)
+                return 1
+            print(f"Detected 2VP boot image format: {loader.file_type.name}")
+
             # Parse the image
             loader.parse()
             
