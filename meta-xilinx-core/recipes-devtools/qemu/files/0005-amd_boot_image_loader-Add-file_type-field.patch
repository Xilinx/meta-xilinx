 13 files changed, 74 insertions(+)

diff --git a/amd_boot_image_loader/loader.py b/amd_boot_image_loader/loader.py
index dc7d911..e4db844 100644
--- a/amd_boot_image_loader/loader.py
+++ b/amd_boot_image_loader/loader.py
@@ -12,9 +12,22 @@ Reference: https://docs.amd.com/r/en-US/ug1283-bootgen-user-guide
 from typing import Optional, BinaryIO
 from pathlib import Path
 from abc import ABC, abstractmethod
+from enum import IntEnum
 import struct
 
 
+class FileType(IntEnum):
+    """Boot image format handled by a loader."""
+
+    UNKNOWN = 0x0
+    ZYNQ = 0x1
+    ZYNQMP = 0x2
+    VERSAL = 0x3
+    VERSALNET = 0x4
+    VERSAL2VE2VM = 0x5
+    VERSAL2VPP = 0x6
+
+
 class BootHeader(ABC):
     """Abstract base class for boot image headers."""
     
@@ -75,6 +88,8 @@ class ImageHeaderWrapper:
 class BootImageLoader(ABC):
     """Abstract base class for loading and processing AMD boot images."""
 
+    file_type: FileType = FileType.UNKNOWN
+
     def __init__(self, image_path: Optional[Path] = None, image_path_offset: int = 0) -> None:
         """Initialize the boot image loader.
         
