+#!/usr/bin/env python3
+# Copyright (C) 2026, Advanced Micro Devices, Inc.  All rights reserved.
+# Portions of this file consist of AI-generated content.
+# SPDX-License-Identifier: MIT
+
+"""Test program for Versal2VPBootImageLoader."""
+
+import sys
+import argparse
+from pathlib import Path
+from amd_boot_image_loader.versal_2vp import Versal2VPBootImageLoader
+
+
+def main():
+    """Main test program entry point."""
+    parser = argparse.ArgumentParser(
+        description='Test program for Versal2VPBootImageLoader',
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+Examples:
+  %(prog)s boot.pdi
+  %(prog)s boot.pdi 0x1000
+  %(prog)s boot.pdi --offset 4096
+        """
+    )
+    
+    parser.add_argument(
+        'filename',
+        type=str,
+        help='Path to the boot image file (PDI)'
+    )
+    
+    parser.add_argument(
+        'offset',
+        nargs='?',
+        default='0',
+        help='Optional offset within the file (decimal or hex with 0x prefix). Default: 0'
+    )
+    
+    parser.add_argument(
+        '-o', '--output-dir',
+        type=str,
+        default='.',
+        help='Output directory for extracted files. Default: current directory'
+    )
+    
+    args = parser.parse_args()
+    
+    # Parse offset (support both decimal and hex)
+    try:
+        offset = int(args.offset, 0)  # 0 base allows both decimal and hex
+    except ValueError:
+        print(f"Error: Invalid offset value '{args.offset}'", file=sys.stderr)
+        return 1
+    
+    # Check if file exists
+    file_path = Path(args.filename)
+    if not file_path.exists():
+        print(f"Error: File not found: {args.filename}", file=sys.stderr)
+        return 1
+    
+    # Create output directory if it doesn't exist
+    output_dir = Path(args.output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    
+    print(f"Loading Versal 2VP boot image (PDI) from: {args.filename}")
+    if offset > 0:
+        print(f"Using offset: {hex(offset)} ({offset} bytes)")
+    
+    try:
+        # Create loader instance and use context manager
+        with Versal2VPBootImageLoader(file_path, offset) as loader:
+            # Parse the image
+            loader.parse()
+            
+            # Call debug function
+            loader.debug()
+
+            # Extract boot header
+            bh_filename = file_path.stem + "_bh.bin"
+            bh_output_path = output_dir / bh_filename
+            loader.dump_boot_header(str(bh_output_path))
+            print(f"\nExtracted boot header: {bh_output_path}")
+            print(f"qemu load argument: -device loader,file={bh_output_path},addr=0xf201e000,force-raw=on")
+
+            # Count total partitions across all images
+            total_partitions = sum(len(partition_headers) for _, partition_headers in loader.image)
+            print(f"\nExtracting {total_partitions} partition(s) from {len(loader.image)} image(s)...")
+            
+            for img_idx in range(len(loader.image)):
+                image_header, partition_headers = loader.image[img_idx]
+                for part_idx, partition_header in enumerate(partition_headers):
+                    # Generate filename for this partition
+                    if image_header.image_name == 'pmc_subsys' and part_idx == 0:
+                        # Use plm.bin for the PLM partition
+                        filename = "plm.bin"
+                    elif part_idx == 0:
+                        filename = image_header.image_name
+                    else:
+                        # Insert partition index before file extension if present
+                        if '.' in image_header.image_name:
+                            name, ext = image_header.image_name.rsplit('.', 1)
+                            filename = f"{name}.{part_idx}.{ext}"
+                        else:
+                            filename = f"{image_header.image_name}.{part_idx}"
+                    
+                    # Get partition type for informational purposes
+                    partition_type = partition_header.get_partition_type().name
+                    
+                    output_path = output_dir / filename
+                    print(f"  Extracting partition {img_idx}.{part_idx}: {output_path} (Type: {partition_type})")
+                    loader.extract(img_idx, part_idx, str(output_path))
+                    
+                    # If this is the pmc_subsys (PLM) partition, also extract the PMC CDO
+                    # The PMC CDO is embedded after the PLM data in the boot image
+                    if image_header.image_name == 'pmc_subsys' and part_idx == 0:
+                        try:
+                            pmc_cdo_output_path = output_dir / "pmc_cdo.bin"
+                            loader.dump_pmc_cdo(str(pmc_cdo_output_path))
+                            print(f"  Extracted PMC CDO: {pmc_cdo_output_path}")
+                            pmc_cdo_load_addr = loader.boot_header.pmc_data_load_address
+                            print(f"qemu load argument: -device loader,file={pmc_cdo_output_path},addr=0x{pmc_cdo_load_addr:08x},force-raw=on")
+                        except ValueError as e:
+                            print(f"  (No PMC CDO data available: {e})")
+                    
+                    # Combine 64-bit load address
+                    load_addr = partition_header.get_destination_load_address()
+                    
+                    # Only print QEMU load argument for partitions with valid load addresses
+                    # CFI and CDO partitions typically have 0xFFFFFFFF as load address
+                    if load_addr != 0xFFFFFFFFFFFFFFFF and load_addr != 0xFFFFFFFF:
+                        print(f"qemu load argument: -device loader,file={output_path},addr=0x{load_addr:016x},force-raw=on")
+                    else:
+                        print(f"  (Configuration data - no QEMU load address)")
+            
+            # Extract optional data if present
+            print(f"\nFound {len(loader.optional_data)} optional data entries")
+            if loader.optional_data:
+                print(f"Extracting optional data entries with non-empty data...")
+                count = 0
+                for idx, opt_data in enumerate(loader.optional_data):
+                    data_id = opt_data.data_id if opt_data.data_id is not None else 0
+                    data_id_name = opt_data.get_data_id_name()
+                    data_size = len(opt_data.data) if opt_data.data else 0
+                    print(f"  Optional data {idx}: ID={data_id:#06x} ({data_id_name}), Size={data_size} bytes")
+                    if opt_data.data:
+                        filename = f"optional_data_{data_id:02X}"
+                        output_path = output_dir / filename
+                        print(f"    Extracting to: {output_path}")
+                        loader.extract_optional_data(idx, str(output_path))
+                        count += 1
+                if count > 0:
+                    print(f"Extracted {count} optional data file(s)")
+                else:
+                    print("No optional data entries with data to extract")
+        
+        return 0
+        
+    except Exception as e:
+        print(f"\nError: {e}", file=sys.stderr)
+        import traceback
+        traceback.print_exc()
+        return 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
